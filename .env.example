# Local environment variables template for development
# Copy or export these variables as needed. Do NOT commit production credentials.

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_doc_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1

# Document Upload & Storage Configuration
STORAGE_LOCAL_ROOT=uploads/documents
MAX_FILE_SIZE=10MB
